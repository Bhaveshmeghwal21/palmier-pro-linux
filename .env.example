# Example environment for Palmier Pro for Linux.
#
#   cp .env.example .env      # then edit; .env is git-ignored and never read by CI
#
# EVERY VARIABLE BELOW IS REAL. Each one is read by src/app/AppSettings.cpp, which
# keeps the complete set of environment reads in a single table so it stays auditable;
# the locale variables at the bottom are read by src/services/LocalizationManager.cpp.
# Nothing here is illustrative filler.
#
# PRECEDENCE, highest first: command-line flag, then environment variable, then the
# config file, then the built-in default. So anything set here can be overridden on the
# command line without editing a file.
#
# EVERY VALUE IS LEFT EMPTY ON PURPOSE. An example file with a plausible-looking token
# in it is how a real token eventually gets committed in its place. Fill values in your
# own .env, never here.

# =============================================================================
# Local MCP endpoint
# =============================================================================
# The in-process Model Context Protocol server that external agents drive the editor
# through. Loopback by default, and that default is the security boundary: on loopback
# the endpoint is unauthenticated because only local processes can reach it.

# Interface for the local endpoint. Default: 127.0.0.1
# Changing this to 0.0.0.0 exposes unauthenticated editor control to your network.
# Use the remote-access settings below instead, which require a token.
PALMIER_MCP_HOST=

# Port for the local endpoint. Default: 19789
PALMIER_MCP_PORT=

# =============================================================================
# Opt-in remote access
# =============================================================================
# Off by default. Read docs/REMOTE_ACCESS.md before enabling any of this: the endpoint
# grants full control of the editor and the file system it can reach.

# Enable the non-loopback listener at all. Default: false
PALMIER_REMOTE_ENABLED=

# Interface for the remote listener, e.g. 0.0.0.0 or a specific address.
PALMIER_REMOTE_BIND_ADDRESS=

# Port for the remote listener.
PALMIER_REMOTE_PORT=

# Bearer token every remote request must present. There is no default and no fallback:
# remote access without a token is refused rather than allowed unauthenticated.
# Generate one with: openssl rand -hex 32
PALMIER_REMOTE_BEARER_TOKEN=

# Explicit acknowledgement that you intend to expose the endpoint. Default: false.
# This exists so that enabling remote access is never a single accidental setting.
PALMIER_REMOTE_ACKNOWLEDGED=

# Comma-separated Origin allow-list for browser-originated requests.
PALMIER_REMOTE_ORIGIN_ALLOW_LIST=

# TLS material for the remote listener. Without both, the listener serves plain HTTP,
# which sends the bearer token above in clear text over the network.
PALMIER_REMOTE_TLS_CERTIFICATE=
PALMIER_REMOTE_TLS_PRIVATE_KEY=

# Concurrent remote session cap, and how long an idle session survives.
PALMIER_REMOTE_MAX_SESSIONS=
PALMIER_REMOTE_IDLE_TIMEOUT_SECONDS=

# How long `timeline.export` may run before it cancels itself and removes the partial
# output. 5..3600 seconds, default 55.
#
# The default suits a short single-layer timeline. A multi-track edit renders at only a
# few frames per second on a modest host - measured at 6.7 fps for one 1080p layer on an
# NVIDIA L4 - so a ten-second five-track project needs this raised to export at all. The
# executor's per-invocation limit is derived from this value with headroom, so the export
# reports its own timeout rather than being killed first.
PALMIER_EXPORT_TOOL_BUDGET_SECONDS=55

# =============================================================================
# Agent and generative service
# =============================================================================

# Which interpreter backs the in-app agent chat.
PALMIER_AGENT_INTERPRETER=

# Generative backend name and endpoint. The generative capability is the one
# account-gated, closed-service part of the product (see NOTICE); with it
# unreachable or unauthenticated the editor works fully without it.
PALMIER_GENERATIVE_BACKEND=
PALMIER_GENERATIVE_ENDPOINT=

# =============================================================================
# Diagnostic logging
# =============================================================================
# See docs/OBSERVABILITY.md. Records go to standard error, so `2> app.log` captures
# the log without touching what the editor writes to standard output.

# Suppress every record below this severity.
# One of: trace, debug, info, warning, error, critical, off. Default: info
# `warn` and `fatal` are accepted as synonyms. An unrecognised value is reported and
# then ignored, rather than silently becoming the default.
PALMIER_LOG_LEVEL=

# How each record is rendered. One of: text, json. Default: text
# `text` is one human-readable line per record; `json` is newline-delimited JSON, so
# `jq` can filter it line by line.
PALMIER_LOG_FORMAT=

# =============================================================================
# Configuration file location
# =============================================================================

# Read configuration from this exact file, bypassing the XDG derivation below.
PALMIER_CONFIG_FILE=

# When PALMIER_CONFIG_FILE is unset, the config path is derived as
# $XDG_CONFIG_HOME/palmier-pro/config, falling back to $HOME/.config/palmier-pro/config.
# Both are standard variables and are listed here only to document the derivation.
# XDG_CONFIG_HOME=
# HOME=

# =============================================================================
# Interface language
# =============================================================================
# Read in this order, first non-empty wins; "C" and "POSIX" are skipped because they
# name no UI language. Standard variables, listed for completeness.
# LC_ALL=
# LC_MESSAGES=
# LANG=
# LANGUAGE=

# =============================================================================
# Used by docker-compose.yml only
# =============================================================================

# Host directory bind-mounted into the container at /workspace/media.
PALMIER_MEDIA_DIR=

# Your X display, for the `editor` compose service. Usually :0
# DISPLAY=
