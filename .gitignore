# Build directories
/build/
/build-*/
/out/
cmake-build-*/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake

# Local environment. `.env` can hold a real PALMIER_REMOTE_BEARER_TOKEN, so it must
# never be committed; the checked-in template beside it is the documentation.
.env
.env.*
!.env.example

# Coverage instrumentation and reports (`make coverage`)
*.gcda
*.gcno
*.gcov
coverage.info
coverage-html/

# Test and CI output produced in the working tree
ctest-results.xml
configure.log
palmier_options.txt

# Packaging output
*.deb
*.ddeb
*.rpm
*.AppImage

# Editor / IDE
.vscode/
.idea/
*.user

# OS
.DS_Store

# Python bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Local planning and agent scratch space, deliberately not part of the repository.
# The specs under `.kiro/` are how this port was planned, not how it is built or used:
# nothing in src/ or the build reads them. The two documentation properties that compare
# the checked reports against `requirements.md` skip themselves when it is absent, so a
# clone without this directory is fully green -- see tests/docs/report_parser_test.cpp.
/.kiro/
/specs/
/_cfgtest/

# Showreel renders and their sidecars: large binaries produced by running the editor,
# not build outputs. Anchored to the root so test fixtures deeper in the tree are
# unaffected. The only committed demo media is the small README GIF under docs/media/.
/showreel/
/*.mp4
/*.mov
/*.mkv
/*.palmier
/*.srt
